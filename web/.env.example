# Firebase Web Config (aus Firebase Console > Projekteinstellungen > Allgemein)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=stockwaage.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=stockwaage
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=stockwaage.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# UID des Owner-Accounts (Markus). Nach erstem Login in Firebase Console > Auth ablesen.
NEXT_PUBLIC_OWNER_UID=
